# Copy to .env for local Compose. Choose an alphanumeric database password.
APP_PORT=8000
POSTGRES_PASSWORD=waypoint-local-only
SEED_PASSWORD=demo123
# Fixed clock makes the supplied June calendar walkthrough repeatable.
# Remove/set empty for current real-world order cutoff handling.
DEMO_CLOCK=2026-06-23T15:00:00+05:30
# Use true behind public HTTPS; false for localhost HTTP.
COOKIE_SECURE=false
# Optional standalone Python overrides (Compose supplies DATABASE_URL itself):
# DATABASE_URL=postgresql://waypoint:password@host:5432/waypoint
# SQLITE_PATH=var/waypoint.db
