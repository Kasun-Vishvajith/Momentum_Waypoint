{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "frontend",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.tools/**,.git/**,.github/**,tests/**,test-results/**,submission/**,var/**,docs/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
  ]
}
